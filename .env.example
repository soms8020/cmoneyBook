# Neon Postgres 연결 정보 (Vercel 대시보드 > Storage > .env.local에서 복사)
POSTGRES_URL="postgresql://..."

# CORS 허용 도메인 (Vercel 배포 후 실제 도메인으로 설정)
# 예: ALLOWED_ORIGIN="https://your-app.vercel.app"
# 여러 도메인: ALLOWED_ORIGIN="https://app.vercel.app,https://custom-domain.com"
# 미설정 시 모든 origin 허용 (*)
ALLOWED_ORIGIN=

# JWT 인증 비밀키 (실제 프로덕션에서는 강력한 무작위 문자열 사용 권장)
JWT_SECRET="your-jwt-secret-key"
